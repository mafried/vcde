    "<div class=\"gi-wrap\">\n",
    "  <div class=\"gi-toolbar\">\n",
    "    <button class=\"gi-btn\" id=\"giToggle\">Globale Beleuchtung: AUS</button>\n",
    "    <span class=\"gi-mode\" id=\"giModeLabel\">Modus: nur lokale (direkte) Beleuchtung</span>\n",
    "  </div>\n",
    "  <article class=\"gi-card\">\n",
    "    <h3 class=\"gi-head\">Cornell-Box (Ziehen = drehen, Mausrad = zoomen)</h3>\n",
    "    <canvas id=\"giCanvas\"></canvas>\n",
    "    <p class=\"gi-note\" id=\"giNote\">\n",
    "      Ohne GI bleibt alles dunkel, was nicht direkt beleuchtet wird – Schatten\n",
    "      werden tiefschwarz und die Wände färben nichts ab.\n",
    "    </p>\n",
    "  </article>\n",
    "</div>\n",
    "\n",
    "<script>\n",
    "window.addEventListener('DOMContentLoaded', function () {\n",
    "  if (!window.BABYLON) return;\n",
    "\n",
    "  const canvas = document.getElementById('giCanvas');\n",
    "  const toggle = document.getElementById('giToggle');\n",
    "  const modeLabel = document.getElementById('giModeLabel');\n",
    "  const note = document.getElementById('giNote');\n",
    "  if (!canvas || !toggle) return;\n",
    "\n",
    "  const engine = new BABYLON.Engine(canvas, true);\n",
    "  const scene = new BABYLON.Scene(engine);\n",
    "  scene.clearColor = new BABYLON.Color3(0.06, 0.07, 0.10);\n",
    "\n",
    "  const camera = new BABYLON.ArcRotateCamera('giCam', -Math.PI / 2, Math.PI / 2.35, 9.5, new BABYLON.Vector3(0, 1.6, 0), scene);\n",
    "  camera.attachControl(canvas, true);\n",
    "  camera.lowerRadiusLimit = 6.5;\n",
    "  camera.upperRadiusLimit = 14;\n",
    "  camera.wheelPrecision = 30;\n",
    "\n",
    "  const RED = new BABYLON.Color3(0.82, 0.18, 0.18);\n",
    "  const GREEN = new BABYLON.Color3(0.20, 0.62, 0.24);\n",
    "  const WHITE = new BABYLON.Color3(0.86, 0.86, 0.86);\n",
    "\n",
    "  // Materialhelfer: ambientColor = diffuseColor, damit scene.ambientColor\n",
    "  // (unser GI-Schalter) das indirekte Grundlicht steuern kann.\n",
    "  function mat(name, color) {\n",
    "    const m = new BABYLON.StandardMaterial(name, scene);\n",
    "    m.diffuseColor = color;\n",
    "    m.specularColor = new BABYLON.Color3(0.05, 0.05, 0.05);\n",
    "    m.ambientColor = color;\n",
    "    return m;\n",
    "  }\n",
    "\n",
    "  const S = 5;            // halbe Boxbreite\n",
    "  const H = 5;            // Höhe\n",
    "  function wall(name, opts, pos, rot, color) {\n",
    "    const w = BABYLON.MeshBuilder.CreatePlane(name, opts, scene);\n",
    "    w.position = pos;\n",
    "    if (rot) w.rotation = rot;\n",
    "    w.material = mat(name + 'Mat', color);\n",
    "    w.receiveShadows = true;\n",
    "    return w;\n",
    "  }\n",
    "\n",
    "  // Boden, Decke, Rückwand (weiß), linke Wand (rot), rechte Wand (grün)\n",
    "  wall('floor', { width: 2 * S, height: 2 * S }, new BABYLON.Vector3(0, 0, 0), new BABYLON.Vector3(Math.PI / 2, 0, 0), WHITE);\n",
    "  wall('ceil', { width: 2 * S, height: 2 * S }, new BABYLON.Vector3(0, H, 0), new BABYLON.Vector3(-Math.PI / 2, 0, 0), WHITE);\n",
    "  wall('back', { width: 2 * S, height: H }, new BABYLON.Vector3(0, H / 2, S), new BABYLON.Vector3(0, Math.PI, 0), WHITE);\n",
    "  wall('left', { width: 2 * S, height: H }, new BABYLON.Vector3(-S, H / 2, 0), new BABYLON.Vector3(0, -Math.PI / 2, 0), RED);\n",
    "  wall('right', { width: 2 * S, height: H }, new BABYLON.Vector3(S, H / 2, 0), new BABYLON.Vector3(0, Math.PI / 2, 0), GREEN);\n",
    "\n",
    "  // Objekte in der Box\n",
    "  const sphere = BABYLON.MeshBuilder.CreateSphere('giSphere', { diameter: 2.0, segments: 32 }, scene);\n",
    "  sphere.position.set(-1.5, 1.0, -0.6);\n",
    "  sphere.material = mat('sphereMat', WHITE);\n",
    "\n",
    "  const box = BABYLON.MeshBuilder.CreateBox('giBox', { width: 1.6, height: 2.8, depth: 1.6 }, scene);\n",
    "  box.position.set(1.5, 1.4, 0.8);\n",
    "  box.rotation.y = -0.4;\n",
    "  box.material = mat('boxMat', WHITE);\n",
    "\n",
    "  // Direkte Lichtquelle an der Decke (immer aktiv)\n",
    "  const lamp = new BABYLON.PointLight('lamp', new BABYLON.Vector3(0, H - 0.4, 0), scene);\n",
    "  lamp.intensity = 0.85;\n",
    "  lamp.diffuse = new BABYLON.Color3(1, 0.97, 0.9);\n",
    "\n",
    "  // sichtbares Lampen-Quad an der Decke\n",
    "  const lampQuad = BABYLON.MeshBuilder.CreatePlane('lampQuad', { width: 2.4, height: 2.4 }, scene);\n",
    "  lampQuad.position.set(0, H - 0.02, 0);\n",
    "  lampQuad.rotation.x = -Math.PI / 2;\n",
    "  const lampMat = new BABYLON.StandardMaterial('lampMat', scene);\n",
    "  lampMat.emissiveColor = new BABYLON.Color3(1, 0.96, 0.85);\n",
    "  lampMat.disableLighting = true;\n",
    "  lampQuad.material = lampMat;\n",
    "\n",
    "  // harte Schatten der direkten Lampe\n",
    "  const shadow = new BABYLON.ShadowGenerator(1024, lamp);\n",
    "  shadow.usePoissonSampling = true;\n",
    "  shadow.addShadowCaster(sphere);\n",
    "  shadow.addShadowCaster(box);\n",
    "\n",
    "  // --- GI-Approximation -----------------------------------------------------\n",
    "  // \"Mit GI\" simulieren wir mit (a) globalem Grundlicht (scene.ambientColor)\n",
    "  // und (b) zwei farbigen Füll-Lichtern, die das Color Bleeding der roten und\n",
    "  // grünen Wand nachahmen. \"Ohne GI\" werden diese ausgeschaltet.\n",
    "  const hemi = new BABYLON.HemisphericLight('giFill', new BABYLON.Vector3(0, 1, 0), scene);\n",
    "  hemi.intensity = 0;\n",
    "  hemi.diffuse = new BABYLON.Color3(0.9, 0.9, 0.95);\n",
    "  hemi.groundColor = new BABYLON.Color3(0.5, 0.5, 0.5);\n",
    "\n",
    "  const redBleed = new BABYLON.PointLight('redBleed', new BABYLON.Vector3(-S + 0.6, 2.2, 0), scene);\n",
    "  redBleed.diffuse = RED;\n",
    "  redBleed.intensity = 0;\n",
    "  redBleed.range = 12;\n",
    "\n",
    "  const greenBleed = new BABYLON.PointLight('greenBleed', new BABYLON.Vector3(S - 0.6, 2.2, 0), scene);\n",
    "  greenBleed.diffuse = GREEN;\n",
    "  greenBleed.intensity = 0;\n",
    "  greenBleed.range = 12;\n",
    "\n",
    "  let gi = false;\n",
    "  function applyMode() {\n",
    "    if (gi) {\n",
    "      scene.ambientColor = new BABYLON.Color3(0.34, 0.34, 0.36);\n",
    "      hemi.intensity = 0.35;\n",
    "      redBleed.intensity = 0.45;\n",
    "      greenBleed.intensity = 0.45;\n",
    "      shadow.setDarkness(0.45);\n",
    "      toggle.textContent = 'Globale Beleuchtung: AN';\n",
    "      toggle.classList.add('secondary');\n",
    "      modeLabel.textContent = 'Modus: globale Beleuchtung (indirektes Licht + Color Bleeding)';\n",
    "      note.textContent = 'Mit GI hellt indirektes Licht die Schatten auf, und die rote/grüne Wand färben Boden und Objekte sichtbar ein.';\n",
    "    } else {\n",
    "      scene.ambientColor = new BABYLON.Color3(0, 0, 0);\n",
    "      hemi.intensity = 0;\n",
    "      redBleed.intensity = 0;\n",
    "      greenBleed.intensity = 0;\n",
    "      shadow.setDarkness(0.0);\n",
    "      toggle.textContent = 'Globale Beleuchtung: AUS';\n",
    "      toggle.classList.remove('secondary');\n",
    "      modeLabel.textContent = 'Modus: nur lokale (direkte) Beleuchtung';\n",
    "      note.textContent = 'Ohne GI bleibt alles dunkel, was nicht direkt beleuchtet wird – Schatten werden tiefschwarz und die Wände färben nichts ab.';\n",
    "    }\n",
    "  }\n",
    "\n",
    "  toggle.addEventListener('click', function () {\n",
    "    gi = !gi;\n",
    "    applyMode();\n",
    "  });\n",
    "\n",
    "  applyMode();\n",
    "  engine.runRenderLoop(function () { scene.render(); });\n",
    "  window.addEventListener('resize', function () { engine.resize(); });\n",
    "});\n",
    "</script>\n",
    "```\n",
    "\n",
    "::: {.callout-note}\n",
    "## Wichtig zu wissen\n",
    "Diese Demo ist eine **Veranschaulichung**, kein physikalisch exakter\n",
    "GI-Renderer. Echte globale Beleuchtung berechnet das Integral der\n",
    "Rendering-Gleichung – genau das machen **Ray Tracing** und **Path Tracing** in\n",
    "den nächsten Leveln.\n",
