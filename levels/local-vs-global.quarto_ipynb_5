    "\n",
    "  function prefix() {\n",
    "    return /\\/levels\\//.test(window.location.pathname) ? \"../\" : \"\";\n",
    "  }\n",
    "\n",
    "  function mascotAvatar() {\n",
    "    return '<span class=\"lvg-fb__avatar\"><img src=\"' + prefix() +\n",
    "      'assets/mascot/guide.png\" alt=\"Lumi\" onerror=\"this.replaceWith(document.createTextNode(\\'💡\\'))\"></span>';\n",
    "  }\n",
    "\n",
    "  function init() {\n",
    "    var qWrap = document.getElementById(\"lvgQuestions\");\n",
    "    var checkBtn = document.getElementById(\"lvgCheck\");\n",
    "    var retryBtn = document.getElementById(\"lvgRetry\");\n",
    "    var fill = document.getElementById(\"lvgFill\");\n",
    "    var scoreEl = document.getElementById(\"lvgScore\");\n",
    "    var feedback = document.getElementById(\"lvgFeedback\");\n",
    "    var warn = document.getElementById(\"lvgWarn\");\n",
    "    if (!qWrap) return;\n",
    "\n",
    "    var gid = \"lvgq-\" + Math.random().toString(36).slice(2, 8);\n",
    "\n",
    "    function esc(s) {\n",
    "      return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\")\n",
    "        .replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\");\n",
    "    }\n",
    "\n",
    "    function render() {\n",
    "      var html = \"\";\n",
    "      QUESTIONS.forEach(function (q, qi) {\n",
    "        html += '<div class=\"lvg-q\" data-qi=\"' + qi + '\" data-answer=\"' + q.answer + '\">';\n",
    "        html += '<span class=\"lvg-q__num\">Frage ' + (qi + 1) + ' / ' + QUESTIONS.length + '</span>';\n",
    "        html += '<p class=\"lvg-q__text\">' + esc(q.q) + '</p>';\n",
    "        q.options.forEach(function (opt, oi) {\n",
    "          html += '<label class=\"lvg-opt\" data-oi=\"' + oi + '\">' +\n",
    "            '<input type=\"radio\" name=\"' + gid + '-' + qi + '\" value=\"' + oi + '\">' +\n",
    "            '<span>' + esc(opt) + '</span></label>';\n",
    "        });\n",
    "        html += '<p class=\"lvg-q__explain\">💡 ' + esc(q.explain) + '</p>';\n",
    "        html += '</div>';\n",
    "      });\n",
    "      qWrap.innerHTML = html;\n",
    "    }\n",
    "\n",
    "    function setBar(correct) {\n",
    "      var pct = Math.round((correct / QUESTIONS.length) * 100);\n",
    "      fill.style.width = pct + \"%\";\n",
    "      scoreEl.textContent = correct + \" / \" + QUESTIONS.length + \" richtig · benötigt: \" + PASS;\n",
    "    }\n",
    "\n",
    "    function evaluate() {\n",
    "      var qNodes = qWrap.querySelectorAll(\".lvg-q\");\n",
    "      var correct = 0;\n",
    "      var answeredAll = true;\n",
    "\n",
    "      qNodes.forEach(function (qn) {\n",
    "        var answer = parseInt(qn.getAttribute(\"data-answer\"), 10);\n",
    "        var opts = qn.querySelectorAll(\".lvg-opt\");\n",
    "        var selected = qn.querySelector(\"input:checked\");\n",
    "\n",
    "        qn.classList.add(\"lvg-q--checked\");\n",
    "        qn.classList.remove(\"lvg-q--correct\", \"lvg-q--wrong\");\n",
    "        opts.forEach(function (o) {\n",
    "          o.classList.remove(\"lvg-opt--correct\", \"lvg-opt--wrong\");\n",
    "          var m = o.querySelector(\".lvg-opt__mark\");\n",
    "          if (m) m.remove();\n",
    "        });\n",
    "\n",
    "        if (opts[answer]) {\n",
    "          opts[answer].classList.add(\"lvg-opt--correct\");\n",
    "          opts[answer].insertAdjacentHTML(\"beforeend\", '<span class=\"lvg-opt__mark\">✓</span>');\n",
    "        }\n",
    "\n",
    "        if (!selected) { answeredAll = false; return; }\n",
    "        var chosen = parseInt(selected.value, 10);\n",
    "        if (chosen === answer) {\n",
    "          correct++;\n",
    "          qn.classList.add(\"lvg-q--correct\");\n",
    "        } else {\n",
    "          qn.classList.add(\"lvg-q--wrong\");\n",
    "          if (opts[chosen]) {\n",
    "            opts[chosen].classList.add(\"lvg-opt--wrong\");\n",
    "            opts[chosen].insertAdjacentHTML(\"beforeend\", '<span class=\"lvg-opt__mark\">✗</span>');\n",
    "          }\n",
    "        }\n",
    "      });\n",
    "\n",
    "      if (!answeredAll) {\n",
    "        warn.classList.add(\"lvg-warn--show\");\n",
    "      } else {\n",
    "        warn.classList.remove(\"lvg-warn--show\");\n",
    "      }\n",
    "\n",
    "      setBar(correct);\n",
    "      fill.classList.toggle(\"lvg-quiz__fill--pass\", correct >= PASS && answeredAll);\n",
    "      showFeedback(correct, answeredAll);\n",
    "    }\n",
    "\n",
    "    function showFeedback(correct, answeredAll) {\n",
    "      var passed = answeredAll && correct >= PASS;\n",
    "      var name, text, cls;\n",
    "\n",
    "      if (passed) {\n",
    "        cls = \"lvg-fb--pass\";\n",
    "        name = \"Lumi\";\n",
    "        if (correct === QUESTIONS.length) {\n",
    "          text = \"🌟 Perfekt – alle \" + QUESTIONS.length + \" richtig! Du bist ein echter Licht-Detektiv. Das Integral hat keine Geheimnisse mehr vor dir.\";\n",
    "        } else {\n",
    "          text = \"🎉 Geschafft, \" + correct + \" von \" + QUESTIONS.length + \" richtig! Du hast lokal vs. global verstanden. Ich schalte das nächste Level frei.\";\n",
    "        }\n",
    "        var next = (window.VCDE && window.VCDE.markComplete)\n",
    "          ? window.VCDE.markComplete(LEVEL_ID)\n",
    "          : null;\n",
    "        if (next) {\n",
    "          text += '<br><a class=\"lvg-fb__next\" href=\"' + prefix() + next.href + '\">Weiter zu „' + esc(next.title) + '“ →</a>';\n",
    "        } else {\n",
    "          text += '<br><a class=\"lvg-fb__next\" href=\"' + prefix() + 'index.html\">Zurück zur Landkarte →</a>';\n",
    "        }\n",
    "        document.querySelectorAll('[data-vcde-levelbar]').forEach(function (el) {\n",
    "          if (window.VCDE && window.VCDE.renderLevelBar) window.VCDE.renderLevelBar(el, LEVEL_ID);\n",
    "        });\n",
    "        checkBtn.disabled = true;\n",
    "      } else if (!answeredAll) {\n",
    "        cls = \"lvg-fb--fail\";\n",
    "        name = \"Lumi\";\n",
    "        text = \"Fast! Ein paar Fragen sind noch offen. Beantworte alle, dann werte ich erneut aus. ✍️\";\n",
    "      } else {\n",
    "        cls = \"lvg-fb--fail\";\n",
    "        name = \"Lumi\";\n",
    "        if (correct >= PASS - 2) {\n",
    "          text = \"Knapp dran: \" + correct + \" von \" + QUESTIONS.length + \" richtig (nötig: \" + PASS + \"). Schau dir die markierten Erklärungen an – du hast es gleich!\";\n",
    "        } else {\n",
    "          text = \"Noch nicht ganz: \" + correct + \" von \" + QUESTIONS.length + \" richtig (nötig: \" + PASS + \"). Kein Stress! Lies die 💡-Erklärungen und starte neu.\";\n",
    "        }\n",
    "      }\n",
    "\n",
    "      feedback.innerHTML =\n",
    "        '<div class=\"lvg-fb ' + cls + '\">' +\n",
    "          mascotAvatar() +\n",
    "          '<div><p class=\"lvg-fb__name\">' + name + '</p><p class=\"lvg-fb__text\">' + text + '</p></div>' +\n",
    "        '</div>';\n",
    "      feedback.classList.add(\"lvg-quiz__feedback--show\");\n",
    "    }\n",
    "\n",
    "    function reset() {\n",
    "      render();\n",
    "      checkBtn.disabled = false;\n",
    "      feedback.classList.remove(\"lvg-quiz__feedback--show\");\n",
    "      feedback.innerHTML = \"\";\n",
    "      warn.classList.remove(\"lvg-warn--show\");\n",
    "      fill.classList.remove(\"lvg-quiz__fill--pass\");\n",
    "      setBar(0);\n",
    "    }\n",
    "\n",
    "    render();\n",
    "    setBar(0);\n",
    "    checkBtn.addEventListener(\"click\", evaluate);\n",
    "    retryBtn.addEventListener(\"click\", reset);\n",
    "  }\n",
    "\n",
    "  if (document.readyState === \"loading\") {\n",
    "    document.addEventListener(\"DOMContentLoaded\", init);\n",
    "  } else {\n",
    "    init();\n",
    "  }\n",
    "})();\n",
    "</script>\n",
