   "source": [
    "#| label: fig-brdf\n",
    "#| fig-cap: 'Reflexionskeulen der BRDF: eine diffuse Fläche (breit) streut Licht gleichmäßig, eine glänzende Fläche (schmal) bündelt es um die Spiegelrichtung.'\n",
    "#| fig-align: center\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "theta = np.linspace(-np.pi / 2, np.pi / 2, 400)\n",
    "diffuse = np.cos(theta)          # breite Lambert-Keule\n",
    "glossy = np.cos(theta) ** 40     # schmale spekulare Keule\n",
    "\n",
    "fig, ax = plt.subplots(subplot_kw={'projection': 'polar'}, figsize=(5.2, 4.2))\n",
    "ax.plot(theta, diffuse, color='#4f46e5', linewidth=2, label='diffus (Lambert)')\n",
    "ax.plot(theta, glossy, color='#f59e0b', linewidth=2, label='glänzend (spekular)')\n",
    "ax.fill(theta, diffuse, color='#4f46e5', alpha=0.10)\n",
    "ax.fill(theta, glossy, color='#f59e0b', alpha=0.15)\n",
    "\n",
    "ax.set_theta_zero_location('N')      # 0° = Oberflächennormale\n",
    "ax.set_theta_direction(-1)\n",
    "ax.set_thetamin(-90)\n",
    "ax.set_thetamax(90)\n",
    "ax.set_rticks([0.5, 1.0])\n",
    "ax.set_rlabel_position(0)\n",
    "ax.set_title('BRDF-Reflexionskeulen', pad=18)\n",
    "ax.legend(loc='lower center', bbox_to_anchor=(0.5, -0.22), ncol=2, frameon=False)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
